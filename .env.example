# Copy to .env and edit. Never commit .env.
DB_PASSWORD="change-me"
# Keep the password in both URLs identical to DB_PASSWORD.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/unimis"
DIRECT_URL="postgresql://postgres:change-me@localhost:5432/unimis"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional testing override (seconds). Leave unset for the real 15-minute window.
# NEXT_PUBLIC_IDLE_SECONDS=30
